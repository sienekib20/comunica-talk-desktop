<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by the Mac App Store -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- V8 compiles JavaScript at runtime. Without this the sandbox refuses the
	     memory it needs and the app dies on launch with "Failed to reserve
	     virtual memory for CodeRange" -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Talks to the Nextcloud server, and to the signalling and TURN servers that
	     carry the calls. Every connection is opened by the app, so the matching
	     "network.server" entitlement is deliberately absent: App Review rejects it
	     as unused, and media that cannot go peer to peer is relayed through TURN -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Calls -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- Attachments: what the user picks, and where downloads land -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
