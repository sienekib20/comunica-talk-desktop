diff --git a/src/components/NewMessage/NewMessageGifPicker.vue b/src/components/NewMessage/NewMessageGifPicker.vue
new file mode 100644
index 0000000..d5a65f1
--- /dev/null
+++ b/src/components/NewMessage/NewMessageGifPicker.vue
@@ -0,0 +1,307 @@
+<!--
+  - SPDX-FileCopyrightText: 2026 Talk Gov.ao
+  - SPDX-License-Identifier: AGPL-3.0-or-later
+-->
+
+<template>
+	<NcPopover v-model:shown="open" popupRole="dialog" :setReturnFocus="setReturnFocus">
+		<template #trigger>
+			<NcButton
+				:disabled="disabled"
+				variant="tertiary"
+				aria-label="Enviar GIF"
+				title="GIF"
+				:aria-haspopup="true">
+				<template #icon>
+					<span class="gif-picker__badge" aria-hidden="true">GIF</span>
+				</template>
+			</NcButton>
+		</template>
+
+		<div class="gif-picker">
+			<label class="gif-picker__search">
+				<IconMagnify :size="18" />
+				<input
+					ref="searchInput"
+					v-model="query"
+					type="search"
+					placeholder="Pesquisar GIF"
+					aria-label="Pesquisar GIF">
+			</label>
+			<div class="gif-picker__chips">
+				<button
+					v-for="chip in CHIPS"
+					:key="chip"
+					type="button"
+					class="gif-picker__chip"
+					:class="{ 'gif-picker__chip--active': term === chip }"
+					@click="query = chip">
+					{{ chip }}
+				</button>
+			</div>
+
+			<div ref="grid" class="gif-picker__grid" @scroll.passive="onScroll">
+				<button
+					v-for="gif in gifs"
+					:key="gif.url"
+					type="button"
+					class="gif-picker__item"
+					:title="gif.title"
+					@click="select(gif)">
+					<img
+						:src="gif.thumbnail"
+						:alt="gif.title"
+						loading="lazy"
+						decoding="async">
+				</button>
+				<div v-if="loading" class="gif-picker__status">
+					A carregar…
+				</div>
+				<div v-else-if="!gifs.length" class="gif-picker__status">
+					{{ failed ? 'Não foi possível carregar os GIF' : 'Nenhum GIF encontrado' }}
+				</div>
+			</div>
+			<p class="gif-picker__credit">
+				GIF por GIPHY, através do servidor gov.ao
+			</p>
+		</div>
+	</NcPopover>
+</template>
+
+<script setup lang="ts">
+import axios from '@nextcloud/axios'
+import { generateOcsUrl } from '@nextcloud/router'
+import debounce from 'debounce'
+import { computed, nextTick, ref, watch } from 'vue'
+import NcButton from '@nextcloud/vue/components/NcButton'
+import NcPopover from '@nextcloud/vue/components/NcPopover'
+import IconMagnify from 'vue-material-design-icons/Magnify.vue'
+
+/*
+ * GIFs through the server's Giphy integration (the Smart picker's provider): the app never
+ * talks to Giphy itself, the thumbnails come through the server. A picked GIF is sent as its
+ * link, which Talk shows as the animated GIF.
+ */
+
+defineProps<{ disabled?: boolean, setReturnFocus?: () => HTMLElement | undefined }>()
+const emit = defineEmits<{ select: [url: string] }>()
+
+const CHIPS = ['Olá', 'Obrigado', 'Parabéns', 'OK', 'Rir', 'Aplausos', 'Bom dia', 'Café']
+
+type Gif = { url: string, thumbnail: string, title: string }
+
+const open = ref(false)
+const query = ref('')
+const term = computed(() => query.value.trim() || CHIPS[0]!)
+const gifs = ref<Gif[]>([])
+const cursor = ref<number | string | null>(null)
+const loading = ref(false)
+const failed = ref(false)
+const searchInput = ref<HTMLInputElement>()
+const grid = ref<HTMLElement>()
+
+let requestId = 0
+
+/**
+ * Fetch a page of results for the current term
+ *
+ * @param more - Next page, appended
+ */
+async function load(more = false) {
+	const id = ++requestId
+	loading.value = true
+	failed.value = false
+	try {
+		const { data } = await axios.get(generateOcsUrl('search/providers/giphy-search-gifs/search'), {
+			headers: { 'OCS-APIRequest': 'true', Accept: 'application/json' },
+			params: { term: term.value, limit: 24, ...(more && cursor.value !== null ? { cursor: cursor.value } : {}) },
+		})
+		if (id !== requestId) {
+			return
+		}
+		const result = data.ocs.data
+		const page = (result.entries ?? []).map((entry: { resourceUrl: string, thumbnailUrl: string, title: string }) => ({
+			url: entry.resourceUrl,
+			thumbnail: entry.thumbnailUrl,
+			title: entry.title,
+		}))
+		gifs.value = more ? [...gifs.value, ...page] : page
+		cursor.value = result.isPaginated && page.length ? result.cursor : null
+	} catch (error) {
+		if (id === requestId) {
+			console.error('Could not load GIFs', error)
+			failed.value = true
+		}
+	} finally {
+		if (id === requestId) {
+			loading.value = false
+		}
+	}
+}
+
+const debouncedLoad = debounce(() => load(), 350)
+
+watch(term, () => {
+	grid.value?.scrollTo({ top: 0 })
+	debouncedLoad()
+})
+
+watch(open, (isOpen) => {
+	if (isOpen) {
+		if (!gifs.value.length) {
+			load()
+		}
+		nextTick(() => searchInput.value?.focus())
+	}
+})
+
+/**
+ * Load the next page when the end of the grid comes near
+ */
+function onScroll() {
+	const el = grid.value
+	if (el && !loading.value && cursor.value !== null && el.scrollTop + el.clientHeight > el.scrollHeight - 200) {
+		load(true)
+	}
+}
+
+/**
+ * Send a GIF
+ *
+ * @param gif - The picked GIF
+ */
+function select(gif: Gif) {
+	emit('select', gif.url)
+	open.value = false
+}
+</script>
