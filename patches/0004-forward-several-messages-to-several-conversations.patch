+ */
+
+import { defineStore } from 'pinia'
+
+/**
+ * Messages picked for forwarding, as in WhatsApp: "Forward" starts a selection in the chat,
+ * more messages can be ticked, then they are sent to one or more conversations.
+ */
+export const useForwardSelectionStore = defineStore('forwardSelection', {
+	state: () => ({
+		/** Conversation the selection belongs to; empty when not selecting */
+		token: '',
+		ids: [] as number[],
+		pickerOpen: false,
+	}),
+
+	actions: {
+		start(token: string, id: number | string) {
+			this.token = token
+			this.ids = [Number(id)]
+			this.pickerOpen = false
+		},
+
+		toggle(id: number | string) {
+			const n = Number(id)
+			const index = this.ids.indexOf(n)
+			if (index === -1) {
+				this.ids.push(n)
+			} else {
+				this.ids.splice(index, 1)
+			}
+		},
+
+		isSelected(id: number | string): boolean {
+			return this.ids.includes(Number(id))
+		},
+
+		cancel() {
+			this.token = ''
+			this.ids = []
+			this.pickerOpen = false
+		},
+	},
+})
