diff --git a/src/components/MessagesList/ForwardSelection/ForwardPicker.vue b/src/components/MessagesList/ForwardSelection/ForwardPicker.vue
new file mode 100644
index 0000000..ed086b0
--- /dev/null
+++ b/src/components/MessagesList/ForwardSelection/ForwardPicker.vue
@@ -0,0 +1,396 @@
+<!--
+  - SPDX-FileCopyrightText: 2026 Talk Gov.ao
+  - SPDX-License-Identifier: AGPL-3.0-or-later
+-->
+
+<template>
+	<NcModal
+		size="small"
+		name="Reencaminhar para…"
+		class="forward-picker"
+		@close="close">
+		<div class="forward-picker__window">
+			<header class="forward-picker__header">
+				<h2 class="forward-picker__title">
+					Reencaminhar para…
+				</h2>
+				<p class="forward-picker__subtitle">
+					{{ selection.ids.length === 1 ? '1 mensagem' : `${selection.ids.length} mensagens` }}
+					· escolha uma ou mais conversas
+				</p>
+				<label class="forward-picker__search">
+					<IconMagnify :size="18" />
+					<input
+						ref="searchInput"
+						v-model="query"
+						type="search"
+						placeholder="Pesquisar conversas"
+						aria-label="Pesquisar conversas">
+				</label>
+				<TransitionGroup
+					v-if="targets.length"
+					tag="div"
+					name="forward-chip"
+					class="forward-picker__chips">
+					<button
+						v-for="target in targets"
+						:key="target.token"
+						class="forward-picker__chip"
+						type="button"
+						:title="`Remover ${target.displayName}`"
+						@click="toggleTarget(target.token)">
+						<ConversationIcon
+							:item="target"
+							:size="20"
+							hideFavorite
+							hideUserStatus
+							disableMenu />
+						<span>{{ target.displayName }}</span>
+						<IconClose :size="14" />
+					</button>
+				</TransitionGroup>
+			</header>
+
+			<ul class="forward-picker__list" role="listbox" aria-multiselectable="true">
+				<li
+					v-for="conversation in conversations"
+					:key="conversation.token"
+					class="forward-picker__row"
+					:class="{ 'forward-picker__row--selected': chosen.includes(conversation.token) }"
+					role="option"
+					:aria-selected="chosen.includes(conversation.token)"
+					tabindex="0"
+					@click="toggleTarget(conversation.token)"
+					@keydown.enter.prevent="toggleTarget(conversation.token)"
+					@keydown.space.prevent="toggleTarget(conversation.token)">
+					<ConversationIcon
+						:item="conversation"
+						:size="40"
+						hideUserStatus
+						disableMenu />
+					<span class="forward-picker__name">{{ conversation.displayName }}</span>
+					<span class="forward-picker__check" aria-hidden="true">
+						<IconCheck :size="16" />
+					</span>
+				</li>
+				<li v-if="!conversations.length" class="forward-picker__empty">
+					Nenhuma conversa encontrada
+				</li>
+			</ul>
+
+			<footer class="forward-picker__footer">
+				<span class="forward-picker__summary">
+					{{ targets.length ? targets.map((t) => t.displayName).join(', ') : 'Nenhuma conversa escolhida' }}
+				</span>
+				<NcButton
+					variant="primary"
+					:disabled="!chosen.length || sending"
+					@click="send">
+					<template #icon>
+						<NcLoadingIcon v-if="sending" :size="20" />
+						<IconSend v-else :size="20" />
+					</template>
+					{{ chosen.length > 1 ? `Reencaminhar (${chosen.length})` : 'Reencaminhar' }}
+				</NcButton>
+			</footer>
+		</div>
+	</NcModal>
+</template>
+
+<script setup lang="ts">
+import { showError, showSuccess } from '@nextcloud/dialogs'
+import { computed, nextTick, onMounted, ref } from 'vue'
+import { useStore } from 'vuex'
+import NcButton from '@nextcloud/vue/components/NcButton'
+import NcLoadingIcon from '@nextcloud/vue/components/NcLoadingIcon'
+import NcModal from '@nextcloud/vue/components/NcModal'
+import IconCheck from 'vue-material-design-icons/Check.vue'
+import IconClose from 'vue-material-design-icons/Close.vue'
+import IconMagnify from 'vue-material-design-icons/Magnify.vue'
+import IconSend from 'vue-material-design-icons/Send.vue'
+import ConversationIcon from '../../ConversationIcon.vue'
+import { CONVERSATION } from '../../../constants.ts'
+import { useForwardSelectionStore } from '../../../stores/forwardSelection.ts'
+
+/** The fields of a conversation used here */
+type Conversation = {
+	token: string
+	displayName: string
+	readOnly: number
+	type: number
+	isFavorite: boolean
+	lastActivity: number
+}
+
+const props = defineProps<{ token: string }>()
+const emit = defineEmits<{ close: [] }>()
+
+const store = useStore()
+const selection = useForwardSelectionStore()
+
+const query = ref('')
+const chosen = ref<string[]>([])
+const sending = ref(false)
+const searchInput = ref<HTMLInputElement>()
+
+/* Conversations the user can write in: favourites first, then the most recent */
+const postable = computed(() => (store.getters.conversationsList as Conversation[])
+	.filter((c) => c.readOnly === CONVERSATION.STATE.READ_WRITE && c.type !== CONVERSATION.TYPE.CHANGELOG)
+	.sort((a, b) => (Number(b.isFavorite) - Number(a.isFavorite)) || (b.lastActivity - a.lastActivity)))
+
+const conversations = computed(() => {
+	const q = query.value.trim().toLowerCase()
+	return q ? postable.value.filter((c) => String(c.displayName).toLowerCase().includes(q)) : postable.value
+})
+
+const targets = computed(() => chosen.value
+	.map((token) => postable.value.find((c) => c.token === token))
+	.filter(Boolean) as Conversation[])
+
+/**
+ * Pick or unpick a conversation
+ *
+ * @param token - Conversation
+ */
+function toggleTarget(token: string) {
+	const index = chosen.value.indexOf(token)
+	if (index === -1) {
+		chosen.value.push(token)
+	} else {
+		chosen.value.splice(index, 1)
+	}
+}
+
+/**
+ * Close the picker; the selection in the chat stays
+ */
+function close() {
+	emit('close')
+}
+
+/**
+ * Forward every selected message, oldest first, to every chosen conversation
+ */
+async function send() {
+	sending.value = true
+	const messages = [...selection.ids]
+		.sort((a, b) => a - b)
+		.map((id) => store.getters.message(props.token, id))
+		.filter(Boolean)
+	let failed = 0
+	for (const targetToken of chosen.value) {
+		for (const message of messages) {
+			try {
+				await store.dispatch('forwardMessage', { targetToken, messageToBeForwarded: message })
+			} catch (error) {
+				console.error('Error while forwarding a message', error)
+				failed++
+			}
+		}
+	}
+	sending.value = false
+
+	const total = messages.length * chosen.value.length
+	if (failed === total) {
+		showError('Não foi possível reencaminhar')
+		return
+	}
+	const what = messages.length === 1 ? 'Mensagem reencaminhada' : `${messages.length} mensagens reencaminhadas`
+	const where = targets.value.length === 1 ? `para ${targets.value[0]!.displayName}` : `para ${targets.value.length} conversas`
+	if (failed) {
+		showError(`${what} ${where}, mas ${failed} não foram enviadas`)
+	} else {
+		showSuccess(`${what} ${where}`)
+	}
+	selection.cancel()
+}
+
+onMounted(() => nextTick(() => searchInput.value?.focus()))
+</script>
+
+<style scoped>
+/* The window has its own title: NcModal's (kept for screen readers) is not shown */
+.forward-picker :deep(.modal-header__name) {
+	position: absolute;
+	width: 1px;
+	height: 1px;
+	overflow: hidden;
+	clip-path: inset(50%);
+}
+
+.forward-picker__window {
+	display: flex;
+	flex-direction: column;
+	height: min(640px, calc(100vh - 120px));
+}
+
+.forward-picker__header {
+	display: flex;
+	flex-direction: column;
+	gap: 10px;
+	padding: 20px 20px 12px;
+	border-bottom: 1px solid var(--color-border);
+}
+
+.forward-picker__title {
+	margin: 0;
+	padding-inline-end: 40px;
+	font-size: 20px;
+	font-weight: 700;
+	letter-spacing: -0.01em;
+}
+
+.forward-picker__subtitle {
+	margin: -6px 0 0;
+	color: var(--color-text-maxcontrast);
+	font-size: 13px;
+}
+
+.forward-picker__search {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	height: 40px;
+	padding: 0 14px;
+	border-radius: 20px;
+	background: var(--color-background-dark);
+	color: var(--color-text-maxcontrast);
+}
+
+.forward-picker__search input {
+	flex: 1;
+	min-width: 0;
+	height: 100%;
+	margin: 0;
+	padding: 0;
+	border: none !important;
+	outline: none;
+	box-shadow: none !important;
+	background: transparent !important;
+	color: var(--color-main-text);
+	font-size: 14px;
+}
+
+.forward-picker__chips {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 6px;
+}
+
+.forward-picker__chip {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	height: 30px;
+	min-height: 0;
+	margin: 0;
+	padding: 0 8px 0 4px;
+	border: none;
+	border-radius: 15px;
+	background: color-mix(in srgb, var(--color-primary-element) 12%, transparent);
+	color: var(--color-main-text);
+	font-size: 13px;
+	font-weight: 500;
+	cursor: pointer;
+}
+
+.forward-picker__chip span {
+	max-width: 140px;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.forward-chip-enter-active,
+.forward-chip-leave-active {
+	transition: opacity 160ms ease, transform 160ms ease;
+}
+
+.forward-chip-enter-from,
+.forward-chip-leave-to {
+	opacity: 0;
+	transform: scale(0.85);
+}
+
+.forward-picker__list {
+	flex: 1;
+	overflow-y: auto;
+	margin: 0;
+	padding: 6px 8px;
+	list-style: none;
+}
+
+.forward-picker__row {
+	display: flex;
+	align-items: center;
+	gap: 12px;
+	min-height: 56px;
+	padding: 6px 10px;
+	border-radius: 12px;
+	cursor: pointer;
+	transition: background-color 120ms ease;
+}
+
+.forward-picker__row:hover {
+	background: var(--color-background-hover);
+}
+
+.forward-picker__row:focus-visible {
+	outline: 2px solid var(--color-primary-element);
+	outline-offset: -2px;
+}
+
+.forward-picker__name {
+	flex: 1;
+	min-width: 0;
+	overflow: hidden;
+	font-size: 15px;
+	font-weight: 500;
+	text-overflow: ellipsis;
