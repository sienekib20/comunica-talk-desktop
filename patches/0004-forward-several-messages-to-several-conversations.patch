+			aria-label="Cancelar seleção"
+			title="Cancelar"
+			@click="selection.cancel()">
+			<template #icon>
+				<IconClose :size="20" />
+			</template>
+		</NcButton>
+		<span class="forward-bar__count">
+			{{ selection.ids.length === 1 ? '1 selecionada' : `${selection.ids.length} selecionadas` }}
+		</span>
+		<NcButton
+			variant="primary"
+			:disabled="!selection.ids.length"
+			aria-label="Reencaminhar"
+			title="Reencaminhar"
+			@click="selection.pickerOpen = true">
+			<template #icon>
+				<IconShare :size="20" />
+			</template>
+			Reencaminhar
+		</NcButton>
+
+		<ForwardPicker v-if="selection.pickerOpen" :token="token" @close="selection.pickerOpen = false" />
+	</div>
+</template>
+
+<script setup lang="ts">
+import { onBeforeUnmount, onMounted } from 'vue'
+import NcButton from '@nextcloud/vue/components/NcButton'
+import IconClose from 'vue-material-design-icons/Close.vue'
+import IconShare from 'vue-material-design-icons/ShareOutline.vue'
+import ForwardPicker from './ForwardPicker.vue'
+import { useForwardSelectionStore } from '../../../stores/forwardSelection.ts'
+
+defineProps<{ token: string }>()
+
+const selection = useForwardSelectionStore()
+
+/**
+ * Escape leaves the selection (unless the picker is open: it closes first)
+ *
+ * @param event - Key press
+ */
+function onKeydown(event: KeyboardEvent) {
+	if (event.key === 'Escape' && !selection.pickerOpen) {
+		selection.cancel()
+	}
+}
+
+onMounted(() => document.addEventListener('keydown', onKeydown))
+onBeforeUnmount(() => {
+	document.removeEventListener('keydown', onKeydown)
+	// Leaving the conversation ends the selection
+	selection.cancel()
+})
+</script>
+
+<style scoped>
+.forward-bar {
+	display: flex;
+	align-items: center;
+	gap: 12px;
+	min-height: 64px;
+	margin: 0 auto 12px;
+	padding: 8px 12px;
+	width: min(100% - 32px, 900px);
+	box-sizing: border-box;
+	border-radius: 20px;
+	background: var(--color-main-background);
+	box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 8px 24px rgba(16, 24, 40, 0.1);
+	animation: forward-bar-in 240ms cubic-bezier(0.2, 0.9, 0.3, 1);
+}
+
+.forward-bar__count {
+	flex: 1;
+	font-size: 15px;
+	font-weight: 600;
+}
+
+@keyframes forward-bar-in {
+	from {
+		opacity: 0;
+		transform: translateY(12px);
+	}
+}
+</style>
